{
  "version": "0.2.1",
  "tasks": [
    {
      "taskLabel": "Run CTest (MSVC Debug)",
      "appliesTo": "CMakeLists.txt",
      "type": "launch",
      "contextType": "build",
      "command": "ctest",
      "args": [
        "--preset", "windows-msvc",
        "--output-on-failure",
        "--stop-on-failure"
      ],
      "workingDirectory": "${workspaceRoot}",
      "problemMatcher": "$gcc"
    },
    {
      "taskLabel": "Run CTest (Clang-CL Debug)",
      "appliesTo": "CMakeLists.txt",
      "type": "launch",
      "contextType": "build",
      "command": "ctest",
      "args": [
        "--preset", "windows-clang",
        "--output-on-failure",
        "--stop-on-failure"
      ],
      "workingDirectory": "${workspaceRoot}",
      "problemMatcher": "$gcc"
    }
  ]
}
