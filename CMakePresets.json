{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "vcpkg-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "FILEPATH",
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        "VCPKG_INSTALLED_DIR": "${sourceDir}/out/v"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "vcpkg-base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows x64 MSVC",
      "description": "Default local Windows build using MSVC.",
      "inherits": "windows-base"
    },
    {
      "name": "windows-clang",
      "displayName": "Windows x64 Clang-CL",
      "description": "Local Windows build using the ClangCL toolset.",
      "inherits": "windows-base",
      "toolset": "ClangCL"
    },
    {
      "name": "vcpkg-linux-base",
      "hidden": true,
      "inherits": "base",
      "environment": {
        "VCPKG_ROOT": "$env{HOME}/vcpkg"
      },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "FILEPATH",
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        "VCPKG_FEATURE_FLAGS": "allow_unsupported"
      }
    },
    {
      "name": "linux-dbg",
      "displayName": "WSL Linux Debug",
      "inherits": "vcpkg-linux-base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_MAKE_PROGRAM": "ninja",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "linux-rel",
      "displayName": "WSL Linux Release",
      "inherits": "linux-dbg",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC (Debug)",
      "configurePreset": "windows-msvc",
      "configuration": "Debug"
    },
    {
      "name": "windows-clang",
      "displayName": "Windows Clang-CL (Debug)",
      "configurePreset": "windows-clang",
      "configuration": "Debug"
    },
    {
      "name": "linux-dbg",
      "configurePreset": "linux-dbg"
    },
    {
      "name": "linux-rel",
      "configurePreset": "linux-rel"
    }
  ],
  "testPresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC (Debug)",
      "configurePreset": "windows-msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "test_session_consolidated|test_repository_consolidated|test_signing_robustness|test_blockcypher_api"
        }
      }
    },
    {
      "name": "windows-clang",
      "displayName": "Windows Clang-CL (Debug)",
      "configurePreset": "windows-clang",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "test_session_consolidated|test_repository_consolidated|test_signing_robustness|test_blockcypher_api"
        }
      }
    },
    {
      "name": "linux-dbg",
      "configurePreset": "linux-dbg",
      "filter": {
        "include": {
          "name": "test_session_consolidated|test_repository_consolidated|test_signing_robustness|test_blockcypher_api"
        }
      }
    },
    {
      "name": "linux-rel",
      "configurePreset": "linux-rel",
      "filter": {
        "include": {
          "name": "test_session_consolidated|test_repository_consolidated|test_signing_robustness|test_blockcypher_api"
        }
      }
    }
  ]
}
